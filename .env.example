# Copiar a .env y ajustar antes de deployar:
#   cp .env.example .env

# --- MongoDB ---
MONGO_ROOT_USER=admin
MONGO_ROOT_PASSWORD=changeme_root_password_strong
MONGO_DB=nicole-trend-shop
MONGO_APP_USER=nicole_app
MONGO_APP_PASSWORD=changeme_app_password_strong

# --- Backend ---
JWT_SECRET=changeme_jwt_secret_minimum_32_characters
PORT=3001

# --- Frontend ---
VITE_API_URL=/api

# --- Nginx ---
NGINX_HTTP_PORT=80
NGINX_HTTPS_PORT=443
